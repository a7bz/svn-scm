      ],
      "svnActivity": [
        {
          "id": "repolog",
          "name": "%svn.view.repolog.name%",
          "when": "config.svn.enabled && svnOpenRepositoryCount != 0"
        },
        {
          "id": "itemlog",
          "name": "%svn.view.itemlog.name%",
          "when": "config.svn.enabled && svnOpenRepositoryCount != 0"
        },
        {
          "id": "branchchanges",
