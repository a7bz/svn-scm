    "configuration": {
      "title": "%svn.configuration.title%",
      "properties": {
        "svn.autorefresh": {
          "type": "boolean",
          "description": "%svn.config.autorefresh.description%",
          "default": true
        },
        "svn.commit.changes.selectedAll": {
          "type": "boolean",
          "description": "%svn.config.commit.changes.selectedAll.description%",
          "default": true
        },
        "svn.commit.checkEmptyMessage": {
          "type": "boolean",
          "description": "%svn.config.commit.checkEmptyMessage.description%",
          "default": true
        },
        "svn.conflicts.autoResolve": {
          "type": "boolean",
          "description": "%svn.config.conflicts.autoResolve.description%",
          "default": false
        },
        "svn.default.encoding": {
          "type": [
            "string",
            "null"
          ],
          "description": "%svn.config.default.encoding.description%",
          "default": null
        },
        "svn.defaultCheckoutDirectory": {
          "type": "string",
          "default": null,
          "description": "%svn.config.defaultCheckoutDirectory.description%"
        },
        "svn.delete.actionForDeletedFiles": {
          "type": "string",
          "enum": [
            "none",
            "prompt",
            "remove"
          ],
          "description": "%svn.config.delete.actionForDeletedFiles.description%",
          "default": "prompt"
        },
        "svn.delete.ignoredRulesForDeletedFiles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "%svn.config.delete.ignoredRulesForDeletedFiles.description%",
          "default": []
        },
        "svn.detectExternals": {
          "type": "boolean",
          "default": true,
          "description": "%svn.config.detectExternals.description%"
        },
        "svn.detectIgnored": {
          "type": "boolean",
          "default": true,
          "description": "%svn.config.detectIgnored.description%"
        },
        "svn.diff.withHead": {
          "type": "boolean",
          "description": "%svn.config.diff.withHead.description%",
          "default": true
        },
        "svn.enabled": {
          "type": "boolean",
          "description": "%svn.config.enabled.description%",
          "default": true
        },
        "svn.experimental.detect_encoding": {
          "type": "boolean",
          "description": "%svn.config.experimental.detect_encoding.description%",
          "default": false
        },
        "svn.experimental.encoding_priority": {
          "type": "array",
          "description": "%svn.config.experimental.encoding_priority.description%",
          "default": [],
          "examples": [
            [
              "UTF-8",
              "GB18030",
              "windows-1251"
            ]
          ]
        },
        "svn.gravatar.icon_url": {
          "type": "string",
          "description": "%svn.config.gravatar.icon_url.description%",
          "examples": [
            "https://www.gravatar.com/avatar/<AUTHOR_MD5>.jpg?s=<SIZE>&d=https%3A%2F%2Fui-avatars.com%2Fapi%2F/<AUTHOR>/128"
          ],
          "default": "https://www.gravatar.com/avatar/<AUTHOR_MD5>.jpg?s=<SIZE>&d=robohash"
        },
        "svn.gravatars.enabled": {
          "type": "boolean",
          "description": "%svn.config.gravatars.enabled.description%",
          "default": true
        },
        "svn.ignoreMissingSvnWarning": {
          "type": "boolean",
          "description": "%svn.config.ignoreMissingSvnWarning.description%",
          "default": false
        },
        "svn.ignoreRepositories": {
          "type": [
            "array",
            null
          ],
          "default": null,
          "scope": "resource",
          "description": "%svn.config.ignoreRepositories.description%"
        },
        "svn.ignoreWorkingCopyIsTooOld": {
          "type": "boolean",
          "description": "%svn.config.ignoreWorkingCopyIsTooOld.description%",
          "default": false
        },
        "svn.layout.branchesRegex": {
          "type": [
            "string",
            "null"
          ],
          "description": "%svn.config.layout.branchesRegex.description%",
          "default": "branches/([^/]+)(/.*)?"
        },
        "svn.layout.branchesRegexName": {
          "type": [
            "number"
          ],
          "description": "%svn.config.layout.branchesRegexName.description%",
          "default": 1
        },
        "svn.layout.showFullName": {
          "type": [
            "boolean"
          ],
          "description": "%svn.config.layout.showFullName.description%",
          "default": true
        },
        "svn.layout.tagRegexName": {
          "type": [
            "number"
          ],
          "description": "%svn.config.layout.tagRegexName.description%",
          "default": 1
        },
        "svn.layout.tagsRegex": {
          "type": [
            "string",
            "null"
          ],
          "description": "%svn.config.layout.tagsRegex.description%",
          "default": "tags/([^/]+)(/.*)?"
        },
        "svn.layout.trunkRegex": {
          "type": [
            "string",
            "null"
          ],
          "description": "%svn.config.layout.trunkRegex.description%",
          "default": "(trunk)(/.*)?"
        },
        "svn.layout.trunkRegexName": {
          "type": [
            "number"
          ],
          "description": "%svn.config.layout.trunkRegexName.description%",
          "default": 1
        },
        "svn.log.length": {
          "type": "number",
          "minimum": 1,
          "description": "%svn.config.log.length.description%",
          "default": 50
        },
        "svn.multipleFolders.depth": {
          "type": "number",
          "minimum": 0,
          "description": "%svn.config.multipleFolders.depth.description%",
          "default": 4
        },
        "svn.multipleFolders.enabled": {
          "type": "boolean",
          "description": "%svn.config.multipleFolders.enabled.description%",
          "default": false
        },
        "svn.multipleFolders.ignore": {
          "type": "array",
          "description": "%svn.config.multipleFolders.ignore.description%",
          "default": [
            "**/.git",
            "**/.hg",
            "**/vendor",
            "**/node_modules"
          ]
        },
        "svn.subRepositories.autoScan.enabled": {
          "type": "boolean",
          "description": "%svn.config.subRepositories.autoScan.enabled.description%",
          "default": true
        },
        "svn.subRepositories.detectedDismissed": {
          "type": "boolean",
          "description": "%svn.config.subRepositories.detectedDismissed.description%",
          "default": false
        },
        "svn.path": {
          "type": [
            "string",
            "null"
          ],
          "description": "%svn.config.path.description%",
          "default": null,
          "scope": "machine"
        },
        "svn.previousCommitsUser": {
          "type": "string",
          "description": "%svn.config.previousCommitsUser.description%",
          "default": null
        },
        "svn.refresh.remoteChanges": {
          "type": "boolean",
          "description": "%svn.config.refresh.remoteChanges.description%",
          "default": false
        },
        "svn.remoteChanges.checkFrequency": {
          "type": "number",
          "description": "%svn.config.remoteChanges.checkFrequency.description%",
          "default": 300
        },
        "svn.showOutput": {
          "type": "boolean",
          "description": "%svn.config.showOutput.description%",
          "default": false
        },
        "svn.showUpdateMessage": {
          "type": "boolean",
          "description": "%svn.config.showUpdateMessage.description%",
          "default": true
        },
        "svn.sourceControl.changesLeftClick": {
          "type": "string",
          "enum": [
            "open",
            "open diff"
          ],
          "description": "%svn.config.sourceControl.changesLeftClick.description%",
          "default": "open diff"
        },
        "svn.sourceControl.combineExternalIfSameServer": {
          "type": "boolean",
          "default": false,
          "description": "%svn.config.sourceControl.combineExternalIfSameServer.description%"
        },
        "svn.sourceControl.countUnversioned": {
          "type": "boolean",
          "description": "%svn.config.sourceControl.countUnversioned.description%",
          "default": true
        },
        "svn.sourceControl.hideUnversioned": {
          "type": "boolean",
          "description": "%svn.config.sourceControl.hideUnversioned.description%",
          "default": false
        },
        "svn.sourceControl.ignore": {
          "type": "array",
          "description": "%svn.config.sourceControl.ignore.description%",
          "default": [],
          "examples": [
            [
              "**/*.js",
              "*.jar",
              "/log",
              "/.vscode/*",
              "!/.vscode/settings.json"
            ]
          ]
        },
        "svn.sourceControl.ignoreOnCommit": {
          "type": "array",
          "description": "%svn.config.sourceControl.ignoreOnCommit.description%",
          "default": [
            "ignore-on-commit"
          ]
        },
        "svn.sourceControl.ignoreOnStatusCount": {
          "type": "array",
          "description": "%svn.config.sourceControl.ignoreOnStatusCount.description%",
          "default": [
            "ignore-on-commit"
          ]
        },
        "svn.update.ignoreExternals": {
          "type": "boolean",
          "description": "%svn.config.update.ignoreExternals.description%",
          "default": true
        }
      }
    },
    "resourceLabelFormatters": [
      {
        "scheme": "svn",
        "formatting": {
          "label": "${path}${authority}",
          "separator": "/",
          "workspaceSuffix": "%svn.resourceLabel.workspaceSuffix%"
