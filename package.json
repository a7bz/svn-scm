{
  "name": "svn-enhanced-by-a7bz",
  "displayName": "%svn.displayName%",
  "description": "%svn.description%",
  "version": "2.17.3",
  "publisher": "a7bz",
  "engines": {
    "vscode": "^1.73.0",
    "node": ">=18.0.0"
  },
  "l10n": "./l10n",
  "packageManager": "pnpm@10.34.1",
  "private": true,
  "enabledApiProposals": [],
  "icon": "images/subversion.png",
  "homepage": "https://github.com/a7bz/svn-scm/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/a7bz/svn-scm"
  },
  "bugs": {
    "url": "https://github.com/a7bz/svn-scm/issues"
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "license": "MIT",
  "keywords": [
    "svn",
    "subversion",
    "enhanced",
    "fork",
    "a7bz",
    "scm"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension",
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:css",
    "package": "node scripts/build.mjs all",
    "build:css": "sass scss/:css/ --style=compressed --silence-deprecation=import --silence-deprecation=global-builtin",
    "build:ts": "vite build",
    "compile": "vite build --watch",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "pnpm run lint --fix",
    "organize": "node ./out/tools/organize.js",
    "package:build": "node scripts/build.mjs build",
    "package:vsix": "node scripts/build.mjs vsix",
    "semantic-release": "semantic-release",
    "style-check": "pnpm prettylint \"src/**/*.ts\"",
    "style-fix": "pnpm prettier --write \"src/**/*.ts\"",
    "test": "node ./out/test/runTest.js",
    "test-compile": "tsc -p ./",
    "tools:genReadme": "node ./out/tools/generateConfigSectionForReadme.js",
    "vscode:prepublish": "pnpm run build",
    "watch:css": "sass scss/:css/ --watch --silence-deprecation=import --silence-deprecation=global-builtin"
  },
  "dependencies": {
    "@vscode/iconv-lite-umd": "^0.7.1",
    "jschardet": "^3.0.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^5.0.1",
    "@semantic-release/git": "^9.0.0",
    "@types/glob": "^7.1.4",
    "@types/minimatch": "3.0.5",
    "@types/mocha": "^9.0.0",
    "@types/node": "^12.11.7",
    "@types/semver": "^7.3.8",
    "@types/tmp": "0.2.1",
    "@types/vscode": "^1.73.0",
    "@types/xml2js": "^0.4.9",
    "@typescript-eslint/eslint-plugin": "^4.29.0",
    "@typescript-eslint/parser": "^4.29.0",
    "chardet": "^1.3.0",
    "dayjs": "^1.10.6",
    "decache": "^4.6.0",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^7.2.0",
    "eslint-plugin-prettier": "^3.4.0",
    "glob": "^7.1.7",
    "milligram": "^1.4.1",
    "minimatch": "^3.0.4",
    "mocha": "^9.0.3",
    "original-fs": "^1.0.0",
    "ovsx": "0.2.0",
    "prettier": "^2.2.1",
    "prettylint": "^1.0.0",
    "sass": "^1.77.0",
    "semantic-release": "^17.4.4",
    "semantic-release-vsce": "^4.0.1",
    "semver": "^7.3.5",
    "tmp": "0.2.1",
    "typescript": "^4.3.5",
    "vite": "^5.4.0",
    "vsce": "^2.15.0",
    "vscode-test": "^1.6.1",
    "xml2js": "^0.4.19"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@parcel/watcher"
    ]
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "svnActivity",
          "title": "%svn.container.subversion.title%",
          "icon": "icons/subversion-logo.svg"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "svn",
          "name": "%svn.view.svn.name%"
